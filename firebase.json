{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.py",
      "**/node_modules/**",
      "Dockerfile",
      "docker-compose.yml",
      "requirements.txt",
      "tu_script.py",
      "guion.json",
      "RESULTADOS_AD",
      "TEMP_PROCESAMIENTO",
      "handoff.md",
      "PLANES_Y_RENTABILIDAD.md",
      "key.txt",
      "storage.rules",
      "firestore.rules",
      ".env"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
